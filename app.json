{
  "expo": {
    "name": "Lily",
    "slug": "app",
    "version": "2.0.8",
    "orientation": "portrait",
    "scheme": "aletheia",
    "newArchEnabled": true,
    "updates": {
      "enabled": false
    },
    "icon": "./assets/images/app-logo.png",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/app-logo.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lily uses your microphone for voice conversations to support your mental wellness.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.aletheia.app",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-logo.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aletheia.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "WAKE_LOCK"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "This app needs access to your microphone for therapy sessions."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lily uses your photos so you can share an image in a conversation."
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f7439f7-93af-4a03-a7a1-113129e701f5"
      }
    },
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000"
  }
}